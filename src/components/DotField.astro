---
/**
 * Interactive dot field.
 *
 * A grid of small dots that reacts to the cursor: nearby dots are pushed
 * outward, grow slightly and darken, then spring back when it passes. Before
 * the pointer ever arrives the field breathes on its own, so the page is never
 * inert.
 *
 * Monochrome on purpose — it should read as texture under the type, not as
 * decoration competing with it.
 */
interface Props {
  /** Height of the field. Any CSS length. */
  height?: string;
  class?: string;
}
const { height = 'clamp(210px, 36vh, 470px)', class: klass = '' } = Astro.props;
---

<div class={`dotfield ${klass}`} style={`--dotfield-h: ${height}`} data-dotfield>
  <canvas data-dotfield-canvas aria-hidden="true"></canvas>
  <span class="dotfield__hint ui" data-dotfield-hint>move your cursor</span>
</div>

<style>
  .dotfield {
    position: relative;
    height: var(--dotfield-h);
    width: 100%;
    /* Reacts to the cursor but must never swallow page scrolling on touch. */
    touch-action: pan-y;
  }
  .dotfield canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dotfield__hint {
    position: absolute;
    left: 0;
    bottom: 0;
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .dotfield__hint.is-shown {
    opacity: 1;
  }
</style>

<script>
  type Dot = { x: number; y: number; ox: number; oy: number; vx: number; vy: number; phase: number };

  const root = document.querySelector<HTMLElement>('[data-dotfield]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-dotfield-canvas]');
  const hint = root?.querySelector<HTMLElement>('[data-dotfield-hint]');

  if (root && canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const PUSH = 26;
    const STIFFNESS = 0.055;
    const DAMPING = 0.86;
    const R_BASE = 1.25;
    /* Scaled by tune() — fixed values leave a phone with a handful of specks. */
    let SPACING = 27;
    let RADIUS = 136;

    let dots: Dot[] = [];
    let w = 0, h = 0, dpr = 1;
    let px = -9999, py = -9999, tx = -9999, ty = -9999;
    let pointerSeen = false;
    let raf = 0, running = false, t = 0;

    /** Deterministic, so the idle drift looks the same on every reload. */
    function mulberry(seed: number) {
      return function () {
        seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
        let x = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
        return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
      };
    }

    function tune(width: number) {
      if (width < 560) {
        SPACING = 21;
        RADIUS = 96;
      } else if (width < 900) {
        SPACING = 24;
        RADIUS = 116;
      } else {
        SPACING = 27;
        RADIUS = 136;
      }
    }

    function build() {
      const rect = root!.getBoundingClientRect();
      tune(rect.width);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Inset the grid so no dot clips at an edge.
      const cols = Math.max(2, Math.floor((w - SPACING) / SPACING));
      const rows = Math.max(2, Math.floor((h - SPACING) / SPACING));
      const offX = (w - (cols - 1) * SPACING) / 2;
      const offY = (h - (rows - 1) * SPACING) / 2;

      const rnd = mulberry(20260818);
      dots = [];
      for (let j = 0; j < rows; j++) {
        for (let i = 0; i < cols; i++) {
          const x = offX + i * SPACING;
          const y = offY + j * SPACING;
          dots.push({ x, y, ox: x, oy: y, vx: 0, vy: 0, phase: rnd() * 6.283 });
        }
      }
    }

    /** Resting grid — also what a reduced-motion visitor gets. */
    function paintStatic() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(0,0,0,0.24)';
      for (const d of dots) {
        d.x = d.ox; d.y = d.oy;
        ctx.beginPath();
        ctx.arc(d.ox, d.oy, R_BASE, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function frame() {
      t += 0.01;
      // Ease the pointer so quick flicks read as pressure, not teleporting.
      px += (tx - px) * 0.18;
      py += (ty - py) * 0.18;

      ctx.clearRect(0, 0, w, h);

      for (const d of dots) {
        const driftAmp = pointerSeen ? 0.5 : 1.5;
        const drift = Math.sin(t + d.ox * 0.012 + d.oy * 0.016 + d.phase) * driftAmp;

        const dx = d.x - px;
        const dy = d.y - py;
        const dist = Math.hypot(dx, dy);

        let ax = 0, ay = 0, heat = 0;
        if (dist < RADIUS && dist > 0.001) {
          // Cosine falloff — no hard edge where the influence stops.
          heat = 0.5 + 0.5 * Math.cos((dist / RADIUS) * Math.PI);
          const force = heat * PUSH;
          ax = (dx / dist) * force;
          ay = (dy / dist) * force;
        }

        d.vx = (d.vx + (d.ox + ax + drift - d.x) * STIFFNESS) * DAMPING;
        d.vy = (d.vy + (d.oy + ay + drift * 0.6 - d.y) * STIFFNESS) * DAMPING;
        d.x += d.vx;
        d.y += d.vy;

        ctx.fillStyle = `rgba(0,0,0,${0.2 + heat * 0.6})`;
        ctx.beginPath();
        ctx.arc(d.x, d.y, R_BASE + heat * 1.5, 0, Math.PI * 2);
        ctx.fill();
      }

      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduced) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    function toLocal(clientX: number, clientY: number) {
      const rect = canvas!.getBoundingClientRect();
      tx = clientX - rect.left;
      ty = clientY - rect.top;
      if (!pointerSeen) {
        pointerSeen = true;
        hint?.classList.remove('is-shown');
        // First contact shouldn't drag dots in from the off-screen origin.
        px = tx; py = ty;
      }
    }

    root.addEventListener('pointermove', (e) => toLocal(e.clientX, e.clientY));
    root.addEventListener('pointerdown', (e) => toLocal(e.clientX, e.clientY));
    root.addEventListener('pointerleave', () => { tx = -9999; ty = -9999; });

    const ro = new ResizeObserver(() => {
      build();
      if (!running) paintStatic();
    });
    ro.observe(root);

    // Only burn frames while the field is actually on screen.
    const io = new IntersectionObserver(
      (entries) => { for (const e of entries) e.isIntersecting ? start() : stop(); },
      { threshold: 0.01 }
    );
    io.observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else io.observe(root);
    });

    if (window.matchMedia('(hover: none)').matches && hint) hint.textContent = 'drag the dots';

    build();
    // rAF is paused in background tabs — draw the resting grid now so the field
    // is never a blank gap.
    paintStatic();
    if (!reduced) {
      start();
      setTimeout(() => { if (!pointerSeen) hint?.classList.add('is-shown'); }, 1100);
    }
  }
</script>
