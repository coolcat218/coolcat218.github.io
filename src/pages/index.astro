---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.jpg';
import { plates } from '../data/art';
import { artImage, workImage } from '../lib/images';

// Lead project: the first in the index order, shown as the full-bleed feature.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const lead = projects[0];
const leadImg = lead.data.image ? workImage(lead.data.image) : undefined;

// Four most recent works. `plates` is already newest-first.
const recent = plates
  .map((pl) => ({ ...pl, img: artImage(pl.file) }))
  .filter((pl) => pl.img)
  .slice(0, 4);
---

<Base
  title="Caitlin Chen"
  description="Caitlin Chen — visual art, math, and generative AI. Based in San Francisco, previously New York."
>
  <!-- Portrait, with the title beside it and the bio beneath, sharing its column -->
  <div class="intro">
    <figure class="intro__figure reveal">
      <Image
        src={portrait}
        alt="Portrait of Caitlin Chen"
        widths={[420, 760, 1025]}
        width={1025}
        sizes="(max-width: 900px) 92vw, 34vw"
        quality={82}
        style="width: 100%;"
      />
    </figure>

    <div class="intro__text reveal d1">
      <h1 class="statement">Hi, I'm Caitlin.</h1>
      <p class="subtitle">Currently based in San Francisco, previously New York.</p>

      <div class="body-copy body-copy--sm" style="margin-top: clamp(26px, 3vw, 40px);">
        <p>
          I love making and looking at visual art, working my way through brainteasers, and
          finding new music.
        </p>
        <p>
          I'm excited about the implications of generative AI for augmenting and broadening
          human creativity. I'm especially interested in the intersection of science, art,
          and technology.
        </p>
        <p>
          I graduated with honors in Applied Math from Harvard and have a background in
          investment banking.
        </p>
      </div>
      <p class="intro__links">
        <a class="pill" href="mailto:caitlin.chen11@gmail.com">get in touch</a>
        <a class="pill" href="/work">work</a>
        <a class="pill" href="/art">visual art</a>
      </p>
    </div>
  </div>

  <!-- Lead project, full bleed, title overlaid -->
  <a class={`feature${leadImg ? '' : ' feature--plain'}`} href={`/work/${lead.id}`}>
    {leadImg && (
      <Image
        class="feature__img"
        src={leadImg}
        alt=""
        widths={[800, 1400, 2000]}
        width={2000}
        sizes="100vw"
        quality={72}
        loading="lazy"
      />
    )}
    <span class="feature__inner">
      <span class="ui feature__meta">Selected work &nbsp;·&nbsp; {lead.data.category}</span>
      <span class="headline feature__title">{lead.data.title}</span>
      <span class="pill pill--light">view project</span>
    </span>
  </a>

  <!-- Recent art: a row header, then a tight four-up -->
  <section aria-labelledby="recent-art">
    <div class="row-head">
      <h2 id="recent-art" class="ui" style="margin: 0;">Recent work on paper and canvas</h2>
      <a class="pill" href="/art">see all</a>
    </div>
    <div class="grid grid--4 grid--flush">
      {recent.map((pl) => (
        <a class="tile reveal" href="/art">
          <span class="tile__frame tile__frame--3x2">
            <Image
              src={pl.img!}
              alt={pl.alt}
              widths={[420, 700, 1000]}
              width={1000}
              sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 25vw"
              quality={74}
              loading="lazy"
            />
          </span>
          <span class="tile__cap">
            <span class="tile__title">{pl.title}</span>
            {pl.year && <span class="ui ui--muted">{pl.year}</span>}
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>
