---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { plates } from '../data/art';
import { artImage, workImage } from '../lib/images';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const cards = plates
  .map((pl) => ({ ...pl, img: artImage(pl.file) }))
  .filter((pl) => pl.img)
  .slice(0, 3);
---

<Base title="Caitlin Chen">
  <!-- Statement -->
  <section class="band statement-band">
    <h1 class="sr">Caitlin Chen — visual art, math, poetry, music</h1>
    <p class="statement reveal">
      I love visual art, math, poetry, and music. I'm excited about generative AI and its
      implications for augmenting and broadening human creativity.
    </p>
    <p class="statement reveal d1" style="margin-top: 1em;">
      I'm especially interested in the intersection of science, art, and technology.
    </p>
    <p style="margin: clamp(26px, 3vw, 38px) 0 0;">
      <a class="pill reveal d2" href="/about">about</a>
    </p>
  </section>

  <!-- Work: full-bleed bands -->
  <section aria-label="Selected work">
    {projects.map((p) => {
      const img = p.data.image ? workImage(p.data.image) : undefined;
      return (
        <a class={`feature${img && img.width >= 1000 ? '' : ' feature--plain'}`} href={`/work/${p.id}`}>
          {img && img.width >= 1000 && (
            <Image
              class="feature__img"
              src={img}
              alt=""
              widths={[800, 1400, 2000]}
              width={2000}
              sizes="100vw"
              quality={72}
              loading="lazy"
            />
          )}
          <span class="feature__inner">
            <span class="ui feature__meta">{p.data.category}</span>
            <span class="headline feature__title">{p.data.title}</span>
            <span class="pill pill--light">view project</span>
          </span>
        </a>
      );
    })}
  </section>

  <!-- Visual art: three-up -->
  <section aria-label="Visual art">
    <div class="band--sm" style="display: flex; justify-content: space-between; align-items: baseline; gap: 1em;">
      <h2 class="ui" style="margin: 0;">Visual art</h2>
      <a class="ui" href="/art" style="border-bottom: 1px solid var(--hair);">all work</a>
    </div>
    <div class="cards">
      {cards.map((pl) => (
        <a class="card" href="/art">
          <Image
            class="card__img"
            src={pl.img!}
            alt={pl.alt}
            widths={[500, 900, 1300]}
            width={1300}
            sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
            quality={74}
            loading="lazy"
          />
          <span class="card__inner">
            <span class="ui card__meta">{pl.medium ?? 'Acrylic, watercolor, charcoal, pencil'}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>
