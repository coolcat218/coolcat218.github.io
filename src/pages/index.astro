---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DotField from '../components/DotField.astro';
import portrait from '../assets/portrait.jpg';
---

<Base
  title="Caitlin Chen"
  description="Caitlin Chen — visual art, math, and generative AI. Based in San Francisco, previously New York."
>
  <!-- Portrait, with the page title and bio set against it -->
  <div class="band">
    <div class="duo duo--intro">
      <figure class="duo__lead reveal" style="margin: 0;">
        <Image
          src={portrait}
          alt="Portrait of Caitlin Chen"
          widths={[420, 760, 1025]}
          width={1025}
          sizes="(max-width: 900px) 92vw, 46vw"
          quality={82}
          style="width: 100%;"
        />
      </figure>

      <div class="duo__body reveal d1">
        <h1 class="statement">Hi, I'm Caitlin.</h1>
        <p class="subtitle">Currently based in San Francisco, previously New York.</p>

        <div class="body-copy" style="margin-top: clamp(24px, 3vw, 38px);">
          <p>
            I love making and looking at visual art, working my way through brainteasers, and
            finding new music.
          </p>
          <p>
            I'm excited about the implications of generative AI for augmenting and broadening
            human creativity. I'm especially interested in the intersection of science, art,
            and technology.
          </p>
          <p>
            I graduated with honors in Applied Math from Harvard and have a background in
            investment banking.
          </p>
        </div>
        <p style="margin: clamp(24px, 3vw, 36px) 0 0; display: flex; gap: 10px; flex-wrap: wrap;">
          <a class="pill" href="mailto:caitlin.chen11@gmail.com">get in touch</a>
          <a class="pill" href="/work">work</a>
          <a class="pill" href="/art">visual art</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive dot field, sitting between the portrait block and the wordmark -->
  <div class="band--sm" style="padding-top: 0;">
    <DotField />
  </div>
</Base>
