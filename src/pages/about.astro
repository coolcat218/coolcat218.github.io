---
/**
 * The about content is the homepage now. This keeps any existing /about link
 * (old Wix inbound links, someone's bookmark) landing in the right place
 * instead of on a 404. Static hosts can't send a 301, so this is the
 * meta-refresh + canonical equivalent.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Caitlin Chen</title>
    <link rel="canonical" href="https://caitlinkchen.com/" />
    <meta http-equiv="refresh" content="0; url=/" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>The about page has moved. <a href="/">Continue to caitlinkchen.com</a>.</p>
  </body>
</html>
