---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { plates } from '../data/art';
import { artImage } from '../lib/images';

const resolved = plates
  .map((pl, i) => ({ ...pl, plate: i + 1, img: artImage(pl.file) }))
  .filter((pl) => {
    if (!pl.img) console.warn(`[art] no file for ${pl.file} — skipping`);
    return Boolean(pl.img);
  });
---

<Base
  title="Visual Art — Caitlin Chen"
  description="Drawings and paintings by Caitlin Chen — acrylic, watercolor, charcoal and pencil."
>
  <section class="band statement-band" style="padding-bottom: clamp(26px, 3vw, 44px);">
    <h1 class="statement reveal">My artwork; acrylic, watercolor, charcoal and pencil.</h1>
    <p class="ui ui--muted" style="margin-top: clamp(18px, 2vw, 26px);">
      {String(resolved.length).padStart(2, '0')} works
    </p>
  </section>

  <div class="plates">
    {resolved.map((pl, i) => (
      <figure class="plate reveal">
        <Image
          src={pl.img!}
          alt={pl.alt}
          widths={[440, 780, 1200]}
          width={1200}
          sizes="(max-width: 700px) 92vw, 46vw"
          quality={76}
          loading={i < 2 ? 'eager' : 'lazy'}
        />
        <figcaption>
          <span class="ui">{pl.title ?? `Plate ${String(pl.plate).padStart(2, '0')}`}</span>
          <span class="ui ui--muted">{[pl.medium, pl.year].filter(Boolean).join(' · ')}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</Base>
